# Copy this file to .env and fill in the values. NEVER commit .env.

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler"
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Secret key used to hash tenant IDs for GA4 (HMAC). Use a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
GA4_HASH_KEY=change-me-to-a-long-random-string
